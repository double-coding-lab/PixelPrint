# 复制成 .env 后填入真实值。.env 被 gitignore 排除。
#
# PETA 鉴权地址:
#   UAT: http://peta.auth.uat.qa.nt.ctripcorp.com  (heraIdToken 可留空)
#   PRO: http://peta.auth.ctripcorp.com            (heraIdToken 必填)
PETA_AUTH_URL=http://peta.auth.uat.qa.nt.ctripcorp.com

# 你的应用 appId(bash 脚本里的 APP_ID)
PETA_APP_ID=

# 你的 apikey 名字(bash 脚本里的 yourAppKeyId / keyName)
PETA_KEY_NAME=

# 生产环境必填,UAT 可留空。详见:
# https://trip.feishu.cn/wiki/GjIbwQDT1ieZs3k2o6Ock8zSn4f
PETA_HERALD_TOKEN=

# 可选:querykey 里的 ip 字段。留空则自动探测本机出网 IP。
PETA_HOST_IP=

# 默认模型。示例:gpt-6-astra / gpt-6 / 你实际能调的名字。
PETA_DEFAULT_MODEL=gpt-6-astra
