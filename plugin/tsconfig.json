{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "typeRoots": ["../node_modules/@types", "../node_modules/@figma"],
    "lib": ["ES2017", "DOM"]
  },
  "include": ["src/**/*"]
}
