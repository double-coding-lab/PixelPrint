# 打开 https://peta.ctripcorp.com,登录后:
# Chrome DevTools → Application → Storage → Cookies → https://peta.ctripcorp.com
# 全选所有条目 → 拷成一整串 "name1=value1; name2=value2; ..." 粘到这里。
#
# 也可以在 DevTools → Network 找一次真实请求 → 右键 Copy → Copy as cURL,
# 里面 -b '...' 单引号里的内容就是这个字符串。
#
# ⚠ Cookie 有时效性(通常几小时到几天),失效后 /analyze 会返 401/403,重新拷一次就行。
PETA_COOKIE=

# 一般不用改
PETA_URL=https://peta.ctripcorp.com/agentApi/openai/chat/completions
PETA_MODEL=gpt-6-astra
PETA_PROVIDER=OpenAI
PETA_BASE_URL=http://aigw.fx.ctripcorp.com/llm/100000420/v1
PETA_SUPPLIER=azure

# 想调试时看 LLM 原始输出:DEBUG_RAW=1
DEBUG_RAW=0
PORT=8787
