{
  "version": "2.0.0",
  "project": {
    "name": "ctrip-train-d2c",
    "framework": "react",
    "styleFormat": "scss"
  },
  "figma": {
    "token": ""
  },
  "merge": {
    "mode": "component"
  },
  "unit": {
    "figmaBase": 375,
    "outputUnit": "px",
    "outputBase": 750,
    "scale": 2
  },
  "images": {
    "assetsDir": "static/figma",
    "imageBaseUrl": "http://127.0.0.1:8080/"
  },
  "layers": {
    "sub": "sub-",
    "block": "block-",
    "img": "img-",
    "bg": "bg-",
    "bgColor": "bgc-",
    "font": "font-",
    "but": "btn-",
    "ignore": "x-"
  },
  "output": {
    "dir": "src/components/generated"
  }
}

