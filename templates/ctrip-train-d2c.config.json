{
  "version": "2.0.0",
  "project": {
    "name": "ctrip-train-d2c",
    "framework": "react",
    "styleFormat": "scss"
  },
  "figma": {
    "token": ""
  },
  "merge": {
    "mode": "component"
  },
  "unit": {
    "figmaBase": 375,
    "outputUnit": "px",
    "outputBase": 750,
    "scale": 2
  },
  "images": {
    "assetsDir": "static/figma",
    "imageBaseUrl": "http://127.0.0.1:8080/"
  },
  "layers": {
    "sub": "sub-",
    "block": "block-",
    "img": "img-",
    "bg": "bg-",
    "bgColor": "bgc-",
    "font": "font-",
    "but": "btn-",
    "scrollX": "scrollx-",
    "scrollY": "scrolly-",
    "ignore": "x-"
  },
  "output": {
    "dir": "src/components/generated"
  },
  "health": {
    "enabled": true,
    "blockOnError": true,
    "report": {
      "markdown": true,
      "json": true,
      "dir": ""
    },
    "thresholds": {
      "maxDepth": 6,
      "subBlockMin": 3,
      "subBlockMax": 20,
      "totalNodesMax": 1500,
      "hiddenRatioMax": 0.2,
      "paddingAsymmetryMax": 32,
      "bgSizeMin": 0.8,
      "bgSizeMax": 1.2,
      "colorDeltaEMin": 3
    },
    "rules": {}
  }
}

